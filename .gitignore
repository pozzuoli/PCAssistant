# >>> PCA-PERSONAL-DATA
# Your personal data (generated by first-time setup) stays out of the shared tool repo.
# To back up YOUR copy to your own PRIVATE repo, first-time setup can remove this block for you
# (or delete it yourself, from the >>> line through the <<< line).
profile/*
!profile/README.md
logging/*
!logging/README.md
!logging/templates/
skills/personal/*
!skills/personal/README.md
# <<< PCA-PERSONAL-DATA

# Never commit backups that contain secrets
logging/backups-private/
# Local Claude Code session settings
.claude/settings.local.json
# Git worktrees that Claude Code sessions create inside the repo (each one is a full checkout)
.claude/worktrees/
# Python bytecode (embeds absolute paths)
__pycache__/
*.pyc
